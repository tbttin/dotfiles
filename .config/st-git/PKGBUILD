# Maintainer: Tin Thai <thaibachthanhtin@gmail.com>

_pkgname='st'
_srcurl="https://git.suckless.org/${_pkgname}"
pkgname="${_pkgname}-git"
pkgver=0.9.3.r6.gfdaadd5
pkgrel=1
pkgdesc='A simple virtual terminal emulator for X'
arch=('i686' 'x86_64')
url='https://st.suckless.org'
license=('custom:MIT')
depends=(
         'libx11'
         'libxft'
         'fontconfig'
         'freetype2'
)
makedepends=('git')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
_patches=(
          'st-fix-terminfo-20231224.patch'
	  'https://st.suckless.org/patches/blinking_cursor/st-blinking_cursor-20230819-3a6d6d7.diff'
)
source=(
        "git+${_srcurl}"
        'config.h'
        ${_patches[@]}
)
sha512sums=(
            'SKIP'
            'SKIP'
            '3d74fd2c4c862bc596943a97fca51a596ac74771bbbac8696088b79b71407aa3dbca6e82d3d7205a37de02d86639df76787952efb7c82b527c8ff53f364cb81f'
            '8327b62df8f2a3d93f2e3872bf84198cc39b4d5e6e9f7559373e6aa16e3ba64574636213200e786d789f75b631630d3e74ab55efd35a7cfd25818a74ed546522'
          )

prepare() {
  cd "${srcdir}/${_pkgname}"
  if [ -f "${srcdir}/config.h" ]
  then
    /usr/bin/cp --verbose --force "${srcdir}/config.h" config.h
  fi
  local patch_file
  for patch_file in ${_patches[@]##*/}
  do
    /usr/bin/echo "Applying ${patch_file}..."
    /usr/bin/patch --silent --input="${srcdir}/${patch_file}"
  done
}

pkgver() {
  cd "${srcdir}/${_pkgname}"
  /usr/bin/git describe --long --tags |
    /usr/bin/sed --regexp-extended 's/([^-]*-g)/r\1/;s/-/./g'
}

build() {
  cd "${srcdir}/${_pkgname}"
  /usr/bin/make \
    X11INC=/usr/include/X11 \
    X11LIB=/usr/lib/X11
}

package() {
  cd "${srcdir}/${_pkgname}"
  local prefix='/usr'
  /usr/bin/make DESTDIR="${pkgdir}" PREFIX="${prefix}" install
  local ins_opts='-D --mode=644'
  local prefix="${pkgdir}/${prefix}"
  /usr/bin/install ${ins_opts} \
    LICENSE "${prefix}/share/licenses/${pkgname}/LICENSE"
  /usr/bin/install ${ins_opts} \
    README "${prefix}/share/doc/${pkgname}/README"
}

# vim: ft=PKGBUILD
